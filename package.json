{
  "name": "hitster",
  "version": "1.0.0",
  "description": "Hitster Game",
  "productName": "Hitster",
  "author": "thorb",
  "private": true,
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 quasar dev",
    "build": "quasar build",
    "dev:electron": "quasar dev -m electron",
    "build:electron": "quasar build -m electron -P never",
    "build:electron:linux": "quasar build -m electron -T linux -P never",
    "build:electron:win": "quasar build -m electron -T win -P never",
    "release:electron": "quasar build -m electron -P always",
    "release:electron:linux": "quasar build -m electron -T linux -P always",
    "release:electron:win": "quasar build -m electron -T win -P always",
    "lint": "eslint . --ext .js,.vue",
    "clean": "quasar clean"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "quasar": "^2.12.0",
    "socket.io-client": "^4.7.5",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@quasar/app-vite": "^1.11.0",
    "autoprefixer": "^10.4.14",
    "electron": "^43.1.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "vue-eslint-parser": "^9.4.3"
  },
  "engines": {
    "node": "^24 || ^22 || ^20 || ^18 || ^16 || ^14.19",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
