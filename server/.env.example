# Beispiel-Konfiguration fuer den Hitster-Server (oeffentlicher Betrieb via
# No-IP-Domain + HTTPS durch einen Reverse-Proxy, z. B. Caddy).
# Kopiere diese Datei nach server/.env und passe die Werte an.
# Die tatsaechliche .env ist per .gitignore vom Repo ausgeschlossen.

# Port des Node-Servers (nur lokal; der Reverse-Proxy leitet 443 hierher).
PORT=3000

# Nur lokal lauschen – der oeffentliche Zugriff laeuft ueber den Reverse-Proxy
# auf demselben Rechner. So ist der rohe HTTP-Port nicht im LAN/Internet offen.
# (Fuer reine Tests im lokalen Netz ohne Proxy leer lassen = 0.0.0.0.)
HOST=127.0.0.1

# Produktionsbetrieb: aktiviert die CORS-Whitelist (ALLOWED_ORIGINS) und macht
# ein gesetztes JWT_SECRET zur Pflicht. Die Desktop-App (Electron, Origin
# "null"/file://) ist davon ausgenommen und funktioniert weiterhin.
NODE_ENV=production

# JWT-Signier-Secret (Pflicht in production). Mind. 32 Zeichen, zufaellig.
# Erzeugen: `openssl rand -hex 32`
# Aendern = alle Nutzer muessen sich einmal neu einloggen.
JWT_SECRET=

# Server-Owner (= Admin). Normalerweise NICHT noetig: auf einem frischen Server
# wird der erste registrierte Account automatisch Owner; auf einem bestehenden
# Server wird beim ersten Start der vorhandene Admin-Account uebernommen. Nur als
# Override setzen (z. B. um den Owner explizit festzulegen). Eins von beiden:
# OWNER_USERNAME=DeinName
# OWNER_ID=<uuid>
OWNER_USERNAME=

# Ablageort fuer Laufzeitdaten (users.json, uploads/, song-classifications.json,
# user-versions.json, restricted-versions.json, server-owner.json, dev-.jwt-secret).
# LEER = neben dem Server-Code (server/).
# Auf dem Homeserver auf einen Ordner AUSSERHALB des Repos setzen, damit der
# taegliche `git pull` nur Code aktualisiert und die Daten nie ueberschreibt.
# Beispiel (Surface, "Serverdaten"-Platte): DATA_DIR=/mnt/serverdaten/hitster/data
DATA_DIR=

# Komma-getrennte Whitelist erlaubter Browser-Origins. Fuer die vom Server selbst
# ausgelieferte Website die eigene HTTPS-Domain eintragen (die Adresse, unter der
# Handys/Browser die Seite oeffnen). Die Desktop-App braucht hier keinen Eintrag.
# Beispiel:
# ALLOWED_ORIGINS=https://hitster.no-ip.org
ALLOWED_ORIGINS=

# Anzahl vertrauenswuerdiger Reverse-Proxy-Hops. Hinter Caddy/nginx auf 1 setzen,
# sonst keyt das Login-Rate-Limit faelschlich auf die Proxy-IP statt auf den
# echten Client.
TRUST_PROXY=1
